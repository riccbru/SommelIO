{
	"expo": {
		"name": "SommelIO",
		"slug": "sommelio",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon/1024_decanter.png",
		"scheme": "sommelio",
		"userInterfaceStyle": "automatic",
		"newArchEnabled": true,
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.riccbru.sommelio",
			"infoPlist": {
				"UIViewControllerBasedStatusBarAppearance": false
			}
		},
		"android": {
			"edgeToEdgeEnabled": true,
			"package": "com.riccbru.sommelio",
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/icon/foreground_432.png",
				"backgroundImage": "./assets/images/icon/background_432.png"
			}
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": ""
		},
		"plugins": [
			"expo-router",
			"expo-secure-store",
			[
				"expo-font",
				{
					"fonts": ["./assets/fonts/Epilogue-Bold.ttf", "./assets/fonts/Epilogue-Regular.ttf"]
				}
			],
			[
				"expo-splash-screen",
				{
					"imageWidth": "200",
					"resizeMode": "contain",
					"backgroundColor": "#ffffff",
					"image": "./assets/images/name/name_nobg_1080.png",
					"dark": {
						"imageWidth": "200",
						"resizeMode": "contain",
						"backgroundColor": "#000000",
						"image": "./assets/images/name/name_nobg_1080.png"
					}
				}
			]
		],
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "de7d0b78-784f-4888-9ffe-d74726288934"
			}
		}
	}
}
