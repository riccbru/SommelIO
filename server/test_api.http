@PORT = 3001
@HOSTNAME = localhost
@token = 
@tid = 

### LOGIN + TOKEN

POST http://{{HOSTNAME}}:{{PORT}}/api/v1/auth/login
Content-Type: application/json

{
    "username": "bankich",
    "password": "bankich_pwd"
}

### REFRESH TOKEN

POST http://{{HOSTNAME}}:{{PORT}}/api/v1/auth/refresh HTTP/1.1

### GET USER INFO

GET http://{{HOSTNAME}}:{{PORT}}/api/v1/users/me/stats HTTP/1.1
Authorization: Bearer {{token}}

### POST NEW USER

POST http://{{HOSTNAME}}:{{PORT}}/api/v1/auth/signup
Content-Type: application/json

{
    "username": "riccbru",
    "email": "riccbru@sommel.io",
    "full_name": "Riccardo Bruno",
    "birthdate": "1999-11-25",
    "password": "riccbru_pwd"
}

### GET TASTINGS

GET http://{{HOSTNAME}}:{{PORT}}/api/v1/tastings HTTP/1.1
Authorization: Bearer {{token}}

### GET TASTING BY ID

GET http://{{HOSTNAME}}:{{PORT}}/api/v1/tastings/{{tid}} HTTP/1.1
Authorization: Bearer {{token}}

### TOGGLE FAVORITE

PATCH http://{{HOSTNAME}}:{{PORT}}/api/v1/tastings/{{tid}} HTTP/1.1
Authorization: Bearer {{token}}

### POST NEW TASTING

POST http://{{HOSTNAME}}:{{PORT}}/api/v1/tastings HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "wine_category_name": "rosé",
    "sample_number": "2025-99",
    "wine_denomination": "Cerasuolo d'Abruzzo DOC",
    "winemaker": "Illuminati",
    "favorite": true,
    "alcohol_content": "13",
    "vintage": 2024,
    "wine_temperature": "16",
    "ambient_temperature": "25",
    "tasting_date": "2024-07-25",
    "tasting_time": "21:00",
    "tasting_location": "Art Cafè"
}

### PUT UPDATE TASTING

PUT http://{{HOSTNAME}}:{{PORT}}/api/v1/tastings/{{tid}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "wine_category_name": "rosé",
    "sample_number": "2025-99",
    "wine_denomination": "Cerasuolo d'Abruzzo DOCG",
    "winemaker": "Illuminati",
    "alcohol_content": "13",
    "vintage": 2025,
    "wine_temperature": "13",
    "ambient_temperature": "25",
    "tasting_date": "2025-07-26",
    "tasting_time": "23:00",
    "tasting_location": "Art Cafè"
}

### DELETE TASTING BY ID

DELETE http://{{HOSTNAME}}:{{PORT}}/api/v1/tastings/{{tid}} HTTP/1.1
Authorization: Bearer {{token}}

### GET EXAMS

GET http://{{HOSTNAME}}:{{PORT}}/api/v1/exams/{{tid}} HTTP/1.1
Authorization: Bearer {{token}}

### POST EXAMS

POST http://{{HOSTNAME}}:{{PORT}}/api/v1/exams/{{tid}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "visual_exam": {
        "limpidity": "quite_limpid",
        "color_family": "rosé",
        "color_shade": "cherry_red",
        "consistency": "flowing",
        "bubble_size": "",
        "bubble_number": "",
        "bubble_persistence": "",
        "notes": "some visual examination note"
    },
    "olfactory_exam": {
        "intensity": "intense",
        "complexity": "complex",
        "quality": "quite_fine",
        "aromatic": false,
        "vinous": false,
        "floral": true,
        "fruity": true,
        "grassy": false,
        "mineral": true,
        "fragrant": true,
        "spicy": false,
        "toasted": false,
        "ethereal": false,
        "notes": "some olfactory examination note"
    },
    "taste_olfactory_exam": {
        "sweetness": "dry",
        "alcohols": "light",
        "softness": "sharp",
        "acidity": "flat",
        "tannicity": "flabby",
        "saltiness": "tasteless",
        "intensity": "intense",
        "persistence": "persistent",
        "quality": "quite_fine",
        "structure": "full",
        "balance": "quite_balanced",
        "notes": "some taste-olfactory examination note"
    },
    "final_considerations": {
        "evolutionary_state": "ready",
        "harmony": "quite_harmonious",
        "pairings": "red meat, fish, cheese",
        "notes": "some final consideration note"
    }
}

