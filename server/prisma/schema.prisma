/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model corrective_coefficients {
  id          Int    @id @default(autoincrement())
  attribute   String @unique
  coefficient Int
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model scoring_evaluation {
  id                   Int      @id @default(autoincrement())
  sid                  String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tid                  String   @unique @db.Uuid
  uid                  String   @db.Uuid
  visual_appearance    Int
  visual_color         Int
  olfactory_intensity  Int
  olfactory_complexity Int
  olfactory_quality    Int
  taste_structure      Int
  taste_balance        Int
  taste_intensity      Int
  taste_persistence    Int
  taste_quality        Int
  harmony              Int
  total_score          Int?
  notes                String?
  tastings             tastings @relation(fields: [tid], references: [tid], onDelete: Cascade, onUpdate: NoAction)
  users                users    @relation(fields: [uid], references: [uid], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model colleagues {
  id                                   Int       @id @default(autoincrement())
  rid                                  String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requester_id                         String    @db.Uuid
  addressee_id                         String    @db.Uuid
  status                               String    @default("pending") @db.VarChar(20)
  created_at                           DateTime? @default(now()) @db.Timestamptz(6)
  updated_at                           DateTime? @default(now()) @db.Timestamptz(6)
  users_colleagues_addressee_idTousers users     @relation("colleagues_addressee_idTousers", fields: [addressee_id], references: [uid], onDelete: Cascade, onUpdate: NoAction)
  users_colleagues_requester_idTousers users     @relation("colleagues_requester_idTousers", fields: [requester_id], references: [uid], onDelete: Cascade, onUpdate: NoAction)

  @@unique([requester_id, addressee_id])
  @@index([addressee_id], map: "idx_colleagues_addressee")
  @@index([requester_id], map: "idx_colleagues_requester")
  @@index([status], map: "idx_colleagues_status")
  @@index([requester_id, addressee_id], map: "idx_colleagues_users")
}

model to_drink {
  id           Int    @id @default(autoincrement())
  wid          String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uid          String @db.Uuid
  denomination String
  winemaker    String
  vintage      Int
  users        users  @relation(fields: [uid], references: [uid], onDelete: Cascade, onUpdate: NoAction)
}

