@PORT = 3001
@HOSTNAME = localhost
@token =
@tid =

### GET EXAMS BY ID

GET http://{{HOSTNAME}}:{{PORT}}/api/v1/exams/{{tid}} HTTP/1.1
Authorization: Bearer {{token}}

### POST EXAMS

POST http://{{HOSTNAME}}:{{PORT}}/api/v1/exams/{{tid}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "visual_exam": {
        "limpidity": "quite_limpid",
        "color_family": "rosé",
        "color_shade": "cherry_red",
        "consistency": "flowing",
        "bubble_size": "",
        "bubble_number": "",
        "bubble_persistence": "",
        "notes": "some visual examination note"
    },
    "olfactory_exam": {
        "intensity": "intense",
        "complexity": "complex",
        "quality": "quite_fine",
        "aromatic": false,
        "vinous": false,
        "floral": true,
        "fruity": true,
        "grassy": false,
        "mineral": true,
        "fragrant": true,
        "spicy": false,
        "toasted": false,
        "ethereal": false,
        "notes": "some olfactory examination note"
    },
    "taste_olfactory_exam": {
        "sweetness": "dry",
        "alcohols": "light",
        "softness": "sharp",
        "acidity": "flat",
        "tannicity": "flabby",
        "saltiness": "tasteless",
        "intensity": "intense",
        "persistence": "persistent",
        "quality": "quite_fine",
        "structure": "full",
        "balance": "quite_balanced",
        "notes": "some taste-olfactory examination note"
    },
    "final_considerations": {
        "evolutionary_state": "ready",
        "harmony": "quite_harmonious",
        "pairings": "red meat, fish, cheese",
        "notes": "some final consideration note"
    }
}

