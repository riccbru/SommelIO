@PORT = 3001
@HOSTNAME = localhost
@token = 
@tid =

### GET SCORING COEFFICIENTS

GET http://{{HOSTNAME}}:{{PORT}}/api/v1/scoring/coefficients HTTP/1.1
Authorization: Bearer {{token}}

### GET SCORING EVALUATION BY ID

GET http://{{HOSTNAME}}:{{PORT}}/api/v1/scoring/{{tid}} HTTP/1.1
Authorization: Bearer {{token}}

### POST NEW SCORING EVALUATION

POST http://{{HOSTNAME}}:{{PORT}}/api/v1/scoring/{{tid}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "visual_appearance": 5,
    "visual_color": 5,
    "olfactory_intensity": 5,
    "olfactory_complexity": 5,
    "olfactory_quality": 5,
    "taste_structure": 5,
    "taste_balance": 5,
    "taste_intensity": 5,
    "taste_persistence": 5,
    "taste_quality": 5,
    "harmony": 5,
    "notes": "some scoring evaluation note"
}

### PUT UPDATE SCORING EVALUATION

PUT http://{{HOSTNAME}}:{{PORT}}/api/v1/scoring/{{tid}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "visual_appearance": 1,
    "visual_color": 1,
    "olfactory_intensity": 1,
    "olfactory_complexity": 1,
    "olfactory_quality": 1,
    "taste_structure": 1,
    "taste_balance": 1,
    "taste_intensity": 1,
    "taste_persistence": 1,
    "taste_quality": 1,
    "harmony": 1,
    "notes": ""
}


### LOGIN + TOKEN

POST http://{{HOSTNAME}}:{{PORT}}/api/v1/auth/login
Content-Type: application/json

{
    "username": "bankich",
    "password": "bankich_pwd"
}

### REFRESH TOKEN

POST http://{{HOSTNAME}}:{{PORT}}/api/v1/auth/refresh HTTP/1.1

###