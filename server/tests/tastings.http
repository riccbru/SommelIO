@PORT = 3001
@HOSTNAME = localhost
@token = 
@tid = 

### LOGIN + TOKEN

POST http://{{HOSTNAME}}:{{PORT}}/api/v1/auth/login
Content-Type: application/json

{
    "username": "bankich",
    "password": "bankich_pwd"
}

### REFRESH TOKEN

POST http://{{HOSTNAME}}:{{PORT}}/api/v1/auth/refresh HTTP/1.1

### LOGOUT (UNSET REFRESH TOKEN COOKIE)

POST http://{{HOSTNAME}}:{{PORT}}/api/v1/auth/logout HTTP/1.1


### GET TASTINGS

GET http://{{HOSTNAME}}:{{PORT}}/api/v1/tastings HTTP/1.1
Authorization: Bearer {{token}}

### GET TASTING BY ID

GET http://{{HOSTNAME}}:{{PORT}}/api/v1/tastings/{{tid}} HTTP/1.1
Authorization: Bearer {{token}}

### TOGGLE FAVORITE

PATCH http://{{HOSTNAME}}:{{PORT}}/api/v1/tastings/{{tid}} HTTP/1.1
Authorization: Bearer {{token}}

### POST NEW TASTING

POST http://{{HOSTNAME}}:{{PORT}}/api/v1/tastings HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "wine_category_name": "rosé",
    "sample_number": "2025-99",
    "wine_denomination": "Cerasuolo d'Abruzzo DOC",
    "winemaker": "Illuminati",
    "favorite": true,
    "alcohol_content": "13",
    "vintage": 2024,
    "wine_temperature": "16",
    "ambient_temperature": "25",
    "tasting_date": "2024-07-25",
    "tasting_time": "21:00",
    "tasting_location": "Art Cafè"
}

### PUT UPDATE TASTING

PUT http://{{HOSTNAME}}:{{PORT}}/api/v1/tastings/{{tid}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "wine_category_name": "rosé",
    "sample_number": "2025-99",
    "wine_denomination": "Cerasuolo d'Abruzzo DOCG",
    "winemaker": "Illuminati",
    "alcohol_content": "13",
    "vintage": 2025,
    "wine_temperature": "13",
    "ambient_temperature": "25",
    "tasting_date": "2025-07-26",
    "tasting_time": "23:00",
    "tasting_location": "Art Cafè"
}

### DELETE TASTING BY ID

DELETE http://{{HOSTNAME}}:{{PORT}}/api/v1/tastings/{{tid}} HTTP/1.1
Authorization: Bearer {{token}}

